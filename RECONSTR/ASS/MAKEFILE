COMPILERDIR = X:

.AUTODEPEND

#.PATH.obj = .

#		*Translator Definitions*
CONFIGFILE = AUDIOLIB.CFG

BINPATH     = $(COMPILERDIR)\BIN\	# 
LIBPATH     = $(COMPILERDIR)\LIB
INCLUDEPATH = $(COMPILERDIR)\INCLUDE

CC          = $(BINPATH)bcc +$(CONFIGFILE)
TASM        = $(BINPATH)TASM
TLIB        = $(BINPATH)tlib
TLINK       = $(BINPATH)tlink


#		*Implicit Rules*
.c.obj:
  $(CC) -c {$< }


#		*List Macros*

LIB_dependencies =  \
 LL_MAN.OBJ \
 MIDI.OBJ \
 TASK_MAN.OBJ \
 FX_MAN.OBJ \
 MUSIC.OBJ \
 AL_MIDI.OBJ \
 MPU401.OBJ \
 BLASTER.OBJ \
 PAS16.OBJ \
 SNDSRC.OBJ \
 DMA.OBJ \
 MULTIVOC.OBJ \
 USER.OBJ \
 OLDTIMBR.OBJ \
 MIX.OBJ

#		*Explicit Rules*
AUDIOLIB.LIB: $(CONFIGFILE) $(LIB_dependencies)
  $(TLIB) AUDIOLIB.LIB +-LL_MAN
  $(TLIB) AUDIOLIB.LIB +-MIDI
  $(TLIB) AUDIOLIB.LIB +-TASK_MAN
  $(TLIB) AUDIOLIB.LIB +-FX_MAN
  $(TLIB) AUDIOLIB.LIB +-MUSIC
  $(TLIB) AUDIOLIB.LIB +-AL_MIDI
  $(TLIB) AUDIOLIB.LIB +-MPU401
  $(TLIB) AUDIOLIB.LIB +-BLASTER
  $(TLIB) AUDIOLIB.LIB +-PAS16
  $(TLIB) AUDIOLIB.LIB +-SNDSRC
  $(TLIB) AUDIOLIB.LIB +-DMA
  $(TLIB) AUDIOLIB.LIB +-MULTIVOC
  $(TLIB) AUDIOLIB.LIB +-USER
  $(TLIB) AUDIOLIB.LIB +-OLDTIMBR
  $(TLIB) AUDIOLIB.LIB +-MIX


#		*Individual File Dependencies*
LL_MAN.OBJ: $(CONFIGFILE) LL_MAN.C

MIDI.OBJ: $(CONFIGFILE) MIDI.C

TASK_MAN.OBJ: $(CONFIGFILE) TASK_MAN.C

FX_MAN.OBJ: $(CONFIGFILE) FX_MAN.C

MUSIC.OBJ: $(CONFIGFILE) MUSIC.C

AL_MIDI.OBJ: $(CONFIGFILE) AL_MIDI.C

MPU401.OBJ: $(CONFIGFILE) MPU401.C

BLASTER.OBJ: $(CONFIGFILE) BLASTER.C

PAS16.OBJ: $(CONFIGFILE) PAS16.C

SNDSRC.OBJ: $(CONFIGFILE) SNDSRC.C

DMA.OBJ: $(CONFIGFILE) DMA.C

MULTIVOC.OBJ: $(CONFIGFILE) MULTIVOC.C

USER.OBJ: $(CONFIGFILE) USER.C

OLDTIMBR.OBJ: $(CONFIGFILE) OLDTIMBR.C

MIX.OBJ: MIX.ASM
	$(TASM) /MX /ZI /O MIX.ASM,MIX.OBJ

#		*Compiler Configuration File*
$(CONFIGFILE): makefile
  copy &&|
-ml
-k
-1
-G
-O
-weas
-wpre
-I$(INCLUDEPATH)
-L$(LIBPATH)
| $(CONFIGFILE)


